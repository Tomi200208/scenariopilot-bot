METACULUS_TOKEN=
OPENROUTER_API_KEY=
# an OpenRouter model id in litellm form, e.g. openrouter/openai/<model>
BOT_MODEL=
# for BOT_VARIANT=ensemble: two or more model ids, comma-separated
BOT_MODELS=
BOT_VARIANT=angles
# default "no_research"; "scenariopilot" (needs the four SP_ values below)
BOT_RESEARCHER=
SP_SUPABASE_URL=
SP_ANON_KEY=
SP_EMAIL=
SP_PASSWORD=
# the A/B control bot (--control): its token, variant (default template) and researcher (default no_research)
METACULUS_TOKEN_CONTROL=
CONTROL_VARIANT=
CONTROL_RESEARCHER=
